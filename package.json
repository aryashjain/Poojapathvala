    "deploy": "npm run build:content && wrangler deploy",
    "test": "npm run build:content && node --test"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "posthog-node": "^6.0.6"
  }
}

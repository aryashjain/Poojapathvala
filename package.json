{
  "name": "textbase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A text-first library of shareable pages, deployed on Cloudflare Workers.",
  "scripts": {
    "build:content": "node scripts/build-content.mjs",
    "dev": "npm run build:content && wrangler dev",
